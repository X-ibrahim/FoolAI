{
  "name": "foolai",
  "version": "3.0.0",
  "description": "FoolAI — Humanize Photos & Remove Watermarks",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w sharp",
    "build:win": "electron-builder --win --x64",
    "build:backend": "pip install pyinstaller iopaint && pyinstaller --onefile --noconsole --name foolai_backend backend/server.py && mkdir -p backend_dist && cp dist/foolai_backend.exe backend_dist/"
  },
  "dependencies": {
    "pdfkit": "^0.19.1",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.roninprx.foolai",
    "productName": "FoolAI",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    },
    "extraResources": [
      {
        "from": "backend_dist/",
        "to": "backend/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/upscayl/",
        "to": "upscayl/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^36.3.1",
    "electron-builder": "^26.0.12",
    "playwright": "^1.60.0"
  }
}
